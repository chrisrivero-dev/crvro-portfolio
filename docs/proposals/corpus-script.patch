diff --git a/scripts/test-corpus.mjs b/scripts/test-corpus.mjs
new file mode 100644
index 0000000..8e8b318
--- /dev/null
+++ b/scripts/test-corpus.mjs
@@ -0,0 +1,15 @@
+// Guards the worker corpus against drifting from the site: every destination the browser can route to must be in the corpus allowlist,
+// every registry project must have entries, and the summaries must match the current registry text (catches a stale snapshot).
+// Run after `npm run corpus:build`:  node scripts/test-corpus.mjs
+import assert from 'node:assert/strict';
+import { readFileSync } from 'node:fs';
+import { PROJECTS, GIS_PROJECTS } from '../src/data/projects.js';
+import { DESTINATIONS } from '../src/data/portfolioNavigator.js';
+
+const corpus = JSON.parse(readFileSync(new URL('../server/corpus.json', import.meta.url), 'utf8'));
+for (const key of Object.keys(DESTINATIONS)) assert.ok(corpus.destinations[key], `corpus.destinations is missing "${key}"`);
+const slugs = new Set(corpus.entries.map((e) => e.slug));
+for (const p of [...PROJECTS, ...GIS_PROJECTS]) assert.ok(slugs.has(p.slug), `corpus has no entries for project "${p.slug}"`);
+const summaries = new Map(corpus.entries.filter((e) => e.id.includes('-summary-')).map((e) => [e.slug, e.text]));
+for (const p of [...PROJECTS, ...GIS_PROJECTS]) assert.equal(summaries.get(p.slug), `${p.title}: ${p.titleEm} ${p.desc}`, `corpus summary for "${p.slug}" is stale`);
+console.log(`corpus ok: ${corpus.entries.length} entries, ${Object.keys(corpus.destinations).length} destinations`);
