# Public Captain broker/worker configuration.
# Copy relevant values into your own shell env before running
# `npm run broker` and `npm run worker` -- never commit real secrets.

# Shared secret the worker presents to the broker's worker-only
# endpoints. Generate a real random value for anything beyond a
# local demo; the broker will otherwise generate one at startup and
# print it once.
PUBLIC_CAPTAIN_WORKER_SECRET=

# Port the local broker listens on.
BROKER_PORT=8787

# Comma-separated list of origins the broker will answer CORS
# preflights for. In production this is exactly the site's own
# origin(s) -- never a wildcard.
ALLOWED_ORIGINS=http://localhost:5183,http://127.0.0.1:5183

# Ollama host the worker talks to. Always localhost -- the worker
# process runs on the same Mac as Ollama and never needs to reach it
# over the network.
OLLAMA_HOST=http://localhost:11434

# Broker URL the worker submits results to (its own outbound target).
# Local dev: http://localhost:8787. Deployed: the site's own public
# URL (e.g. https://<preview>.vercel.app), since the broker is deployed
# as Vercel Functions (api/) alongside the static site -- the worker
# still only ever makes outbound HTTPS calls, same as always.
BROKER_URL=http://localhost:8787

# Broker URL the BROWSER (Vite frontend) calls. Exposed to the client
# bundle -- never put a secret in this one. Leave unset in production:
# the frontend then calls same-origin relative paths (/api/ask, etc),
# which is correct once the broker is deployed alongside the site. Only
# set this if the broker is ever hosted on a different origin.
VITE_BROKER_URL=http://localhost:8787

# Vercel Queues (job dispatch, broker -> worker). Auto-detected from the
# Vercel environment when deployed; for local testing, `vercel link` then
# `vercel env pull` supplies VERCEL_OIDC_TOKEN in .env.local.
VERCEL_REGION=iad1

# Upstash Redis (result/status store), injected automatically by the
# Vercel Marketplace integration into .env.local via `vercel env pull` --
# never set these by hand, and never commit the real values. The broker
# falls back to an in-memory store when these are absent (local dev before
# Upstash is provisioned), so nothing breaks without them.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# --- Public Captain isolation / containment kill-switches (see
# docs/PUBLIC_CAPTAIN.md) -- all default to the SAFE/OFF state when
# unset. Only the worker process reads these; none are ever exposed to
# the browser bundle. ---

# Master switch for the public reasoning path (Groq and/or local
# qwen3:4b). While unset/false, the worker only ever answers via the
# deterministic fast path and returns "busy" for everything else --
# zero model calls, local or cloud. Set to true only once the public
# model path has been reviewed and approved.
PUBLIC_CAPTAIN_INFERENCE_ENABLED=false

# Local Ollama model client tuning -- see worker/ollama.mjs for the
# measured defaults and why they're set where they are.
PUBLIC_MODEL_NUM_CTX=8192
PUBLIC_MODEL_NUM_PREDICT=3500
PUBLIC_MODEL_TIMEOUT_MS=45000

# Groq (server-side only -- worker/groq.mjs). NEVER prefix with VITE_;
# never place in client code. Get a key from console.groq.com and put
# it in .env.local (gitignored), never in this file or any tracked
# file. Absence disables Groq entirely (isGroqConfigured() -> false)
# and the worker falls straight to the local qwen3:4b path.
GROQ_API_KEY=

# Whether Groq (openai/gpt-oss-20b) is tried before the local qwen3:4b
# fallback. Off by default until the side-by-side benchmark in
# docs/PUBLIC_CAPTAIN.md is reviewed and approved -- with GROQ_API_KEY
# set but this left false, the key is simply unused.
PUBLIC_CAPTAIN_GROQ_ENABLED=false

# Reasoning effort passed to Groq -- "low" by default for this
# latency-sensitive Q&A surface. Only escalate if a benchmark shows low
# effort hurts answer quality (see docs/PUBLIC_CAPTAIN.md).
GROQ_REASONING_EFFORT=low
GROQ_TIMEOUT_MS=15000
